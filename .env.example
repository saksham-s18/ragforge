# ==============================================================================
# RAGForge Environment Configuration Template
# Copy this file to .env and customize for local development.
# ==============================================================================

# Core Application
RAGFORGE_ENV=development
RAGFORGE_LOG_LEVEL=INFO
RAGFORGE_APP_NAME=ragforge
RAGFORGE_DEBUG=false
RAGFORGE_API_V1_PREFIX=/api/v1

# Server Settings
RAGFORGE_HOST=0.0.0.0
RAGFORGE_PORT=8000

# Database / Storage
# RAGFORGE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragforge
RAGFORGE_QDRANT_URL=http://localhost:6333
# RAGFORGE_QDRANT_API_KEY=
RAGFORGE_QDRANT_COLLECTION=ragforge_chunks
# Configured vector dimension: 64 for Deterministic provider, 384 for FastEmbed BAAI/bge-small-en-v1.5
RAGFORGE_QDRANT_VECTOR_DIMENSION=64

# LLM & Embedding Providers
RAGFORGE_EMBEDDING_PROVIDER=fastembed
RAGFORGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAGFORGE_EMBEDDING_CACHE_DIR=
# RAGFORGE_OPENAI_API_KEY=
# RAGFORGE_LLM_PROVIDER=openai
